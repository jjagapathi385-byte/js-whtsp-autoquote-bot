# ── Flask service ─────────────────────────────────────────────
REDIS_URL=rediss://default:xxxx@xxxx.upstash.io:6379
ADMIN_PIN=choose-a-long-pin
FLASK_SECRET_KEY=any-long-random-string
BRIDGE_SECRET=another-long-random-string      # same value in both services
BRIDGE_URL=https://your-bridge-service.up.railway.app
DEFAULT_CUSTOMER_NAME=DEFAULT-CUSTOMER        # must exist in Zoho; used when the store is unclear
OWNER_NUMBERS=your-10-digit-number            # ignored completely
OWNER_JIDS=                                   # only if WhatsApp hides your number (see DEPLOY.md)
GROQ_API_KEY=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Bridge service ────────────────────────────────────────────
FLASK_URL=https://your-flask-service.up.railway.app
BRIDGE_SECRET=same-as-above
WHATSAPP_GROUP_ID=                            # leave empty on the first run; the bridge prints your groups
AUTH_DIR=/data/auth                           # mount a Railway volume at /data
